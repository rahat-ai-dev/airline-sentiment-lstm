# data/raw/*.csv

# --- Models & large artifacts ---
models/*.keras
models/*.joblib
!models/.gitkeep

# --- Streamlit ---
.streamlit/secrets.toml

# --- Environment / secrets ---
.env
*.env.local

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp
