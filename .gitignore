# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# --- Data (raw data stays local / documented in DATASET.md, not committed) ---
data/interim/*
data/external/*
!data/interim/.gitkeep
!data/external/.gitkeep
