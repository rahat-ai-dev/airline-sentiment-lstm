# Copy this file to `.env` and fill in real values before running locally.
# Nothing in this project currently requires secrets to run — this file is
# provided so the pattern is in place if the project grows (e.g. adding a
# hosted inference API key, a cloud storage bucket for the dataset, etc.).

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

